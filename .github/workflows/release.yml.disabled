# SPDX-FileCopyrightText: 2026 ybblab
# SPDX-License-Identifier: Apache-2.0
#
# Builds, signs and verifies the APK for an existing version tag, and creates a draft release with the
# APK, its SHA-256 and release.json: the one file the app reads to learn of a new version, from
# github.com/<repo>/releases/latest/download/release.json (never GitHub's API). Publishing the draft
# makes it the latest release, and the app offers it. Adapted from Droidance.
name: Prepare release draft
on:
  workflow_dispatch:
    inputs:
      tag:
        description: Existing version tag, such as v0.1.0
        required: true
        type: string
      release_notes_zh:
        description: Simplified Chinese release and in-app update notes
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: release-${{ inputs.tag }}
  cancel-in-progress: false
jobs:
  release:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    environment: release
    permissions:
      contents: write
    env:
      RELEASE_TAG: ${{ inputs.tag }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.tag }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
      - name: Validate tagged source and release identity
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_NOTES_ZH: ${{ inputs.release_notes_zh }}
        run: |
          git merge-base --is-ancestor "refs/tags/$RELEASE_TAG^{commit}" origin/main
          python3 code/scripts/release.py identity --tag "$RELEASE_TAG" --output "$RUNNER_TEMP/release"
          if gh release view "$RELEASE_TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
            echo 'A release or draft already exists for this tag; its assets will not be replaced'; exit 1
          fi
      - name: Build unsigned release APK
        working-directory: code
        env:
          ORG_GRADLE_PROJECT_jiumiRepository: ${{ github.repository }}
        run: ./gradlew --no-daemon :app:assembleRelease
      - name: Sign and verify final APK, write release.json
        env:
          SIGNING_KEYSTORE_BASE64: ${{ secrets.SIGNING_KEYSTORE_BASE64 }}
          SIGNING_ALIAS: ${{ secrets.SIGNING_ALIAS }}
          SIGNING_STORE_PASSWORD: ${{ secrets.SIGNING_STORE_PASSWORD }}
          SIGNING_KEY_PASSWORD: ${{ secrets.SIGNING_KEY_PASSWORD }}
          SIGNING_CERT_SHA256: ${{ vars.SIGNING_CERT_SHA256 }}
        run: |
          set -euo pipefail
          trap 'rm -f "$RUNNER_TEMP/release.jks"' EXIT
          for name in SIGNING_KEYSTORE_BASE64 SIGNING_ALIAS SIGNING_STORE_PASSWORD SIGNING_KEY_PASSWORD SIGNING_CERT_SHA256; do
            if [ -z "${!name:-}" ]; then echo "Missing release configuration: $name"; exit 1; fi
          done
          echo "$SIGNING_KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.jks"
          chmod 600 "$RUNNER_TEMP/release.jks"
          # Use the same stable build-tools version for signing and verification.
          tools="$ANDROID_HOME/build-tools/35.0.0"
          test -x "$tools/apksigner"
          sdk="$RUNNER_TEMP/release-sdk"
          mkdir -p "$sdk/build-tools" "$sdk/cmdline-tools"
          ln -s "$tools" "$sdk/build-tools/35.0.0"
          ln -s "$ANDROID_HOME/cmdline-tools/latest" "$sdk/cmdline-tools/latest"
          apk="$RUNNER_TEMP/release/jiumi-${RELEASE_TAG#v}.apk"
          "$tools/zipalign" -P 16 -f 4 code/app/build/outputs/apk/release/app-release-unsigned.apk "$RUNNER_TEMP/aligned.apk"
          "$tools/apksigner" sign --ks "$RUNNER_TEMP/release.jks" --ks-key-alias "$SIGNING_ALIAS" \
            --ks-pass env:SIGNING_STORE_PASSWORD --key-pass env:SIGNING_KEY_PASSWORD --out "$apk" "$RUNNER_TEMP/aligned.apk"
          "$tools/apksigner" verify --print-certs "$apk"
          python3 code/scripts/release.py verify-apk --identity "$RUNNER_TEMP/release/identity.json" --apk "$apk" \
            --sdk "$sdk" --certificate "$SIGNING_CERT_SHA256"
      - name: Create draft release with the APK and release.json
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          flags=()
          if [[ "$RELEASE_TAG" == *-* ]]; then flags+=(--prerelease); fi
          release_dir="$RUNNER_TEMP/release"
          {
            cat "$release_dir/notes.zh.md"
            printf '\n---\n\n'
            cat "$release_dir/notes.md"
          } > "$release_dir/release-notes.md"
          gh release create "$RELEASE_TAG" --repo "$GITHUB_REPOSITORY" --verify-tag --draft "${flags[@]}" \
            --title "Jiumi ${RELEASE_TAG#v}" --notes-file "$release_dir/release-notes.md" \
            "$release_dir/"*.apk "$release_dir/"*.sha256 "$release_dir/release.json"
