<?xml version="1.0" encoding="utf-8"?>
<!--
The running notification, the same folded and unfolded: the status and how long, then the session's
two figures in one line (or when it began, without a summary); a stop button at the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <include layout="@layout/notification_monitoring_header" />

        <TextView
            android:id="@+id/notification_text"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notification_stop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_notification_stop"
        android:contentDescription="@string/action_stop_monitoring"
        android:scaleType="center"
        android:src="@drawable/ic_notification_stop" />
</LinearLayout>
